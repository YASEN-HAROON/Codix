generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  displayName  String?
  phone        String?
  bio          String?
  location     String?
  timezone     String    @default("Pacific Time (PT)")
  avatarLetter String?   // single letter shown in UI
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Preferences / settings stored as JSON for flexibility
  settings     Json      @default("{}")

  projects     ProjectMember[]
  tasks        Task[]
  ownedProjects Project[] @relation("ProjectOwner")

  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(IN_PROGRESS)
  progress    Int      @default(0) // 0-100
  color       String   @default("#6366f1")
  ownerId     String
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ProjectMember[]
  tasks       Task[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member") // owner | member
  joinedAt  DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Task {
  id          String   @id @default(cuid())
  title       String
  completed   Boolean  @default(false)
  tag         String?  // Code, Planning, Design, Comm, etc.
  projectId   String?
  userId      String   // assignee / creator
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}
